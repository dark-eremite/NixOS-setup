import QtQuick

QtObject {
    id: palette

    readonly property color bg: "{{ colors.surface.default.hex }}"
    readonly property color fg: "{{ colors.on_surface.default.hex }}"
    readonly property color accent: "{{ colors.primary.default.hex }}"
    readonly property color on_accent: "{{ colors.on_primary.default.hex }}"
    readonly property color border: "<* if {{ is_dark_mode }} *>{{ colors.white_source.default.rgba | set_alpha: 0.35 | format: "alpha_hex" }}<* else *>{{ colors.black_source.default.rgba | set_alpha: 0.35 | format: "alpha_hex" }}<* endif *>"
}
