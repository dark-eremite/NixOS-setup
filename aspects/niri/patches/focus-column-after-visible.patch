+    /// Focus the first column to the right of the visible area.
+    ///
+    /// Unlike focus_right(), this skips the columns that are already fully
+    /// visible, so that the view scrolls to the next column instead of just
+    /// switching to a window that is already on screen.
+    pub fn focus_column_after_visible(&mut self) {
+        if self.columns.is_empty() {
+            return;
+        }
+
+        // Consider the end of an ongoing animation because that's what compute to fit does too.
+        let view_x = self.target_view_pos();
+        let view_right = view_x + self.working_area.size.w;
+
+        // Find the first column that isn't fully visible yet: either it peeks in
+        // from the right, or it's entirely to the right of the view.
+        let mut last_visible = None;
+        let mut target = None;
+        for (idx, col_x) in self
+            .column_xs(self.data.iter().copied())
+            .take(self.columns.len())
+            .enumerate()
+        {
+            let width = self.data[idx].width;
+
+            if col_x + width <= view_x {
+                // Column is entirely to the left of the view.
+                continue;
+            }
+
+            if col_x <= view_x && col_x + width >= view_right {
+                // Column is wider than the view, so it covers all of it.
+                last_visible = Some(idx);
+                continue;
+            }
+
+            if col_x < view_x {
+                // Column is cut off at the left edge of the view.
+                continue;
+            }
+
+            if col_x >= view_right || col_x + width > view_right {
+                // Column is not fully visible: this is the one to bring in.
+                target = Some(idx);
+                break;
+            }
+
+            // Column is fully visible.
+            last_visible = Some(idx);
+        }
+
+        let Some(target) = target.or_else(|| last_visible.map(|idx| idx + 1)) else {
+            return;
+        };
+
+        if target >= self.columns.len() {
+            // Nothing to the right of the visible area.
+            return;
+        }
+
+        self.activate_column(target);
+    }
