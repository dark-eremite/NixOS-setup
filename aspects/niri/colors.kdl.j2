layout {
    border {
        on
        width 2
        active-color "{{ colors.primary.default.rgba | set_alpha: 0.35 }}"
        inactive-color "<* if {{ is_dark_mode }} *>{{ colors.white_source.default.rgba | set_alpha: 0.35 }}<* else *>{{ colors.black_source.default.rgba | set_alpha: 0.35 }}<* endif *>"
    }

    focus-ring {
        off
    }
}
