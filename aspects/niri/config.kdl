input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
    }
    touchpad {
        natural-scroll
    }
}

layout {
    gaps 8

    background-color "transparent"

    focus-ring {
        off
    }

    border {
        on
        width 2
        active-color "rgba(127, 200, 255, 0.35)"
        inactive-color "rgba(128, 128, 128, 0.35)"
    }

    tab-indicator {
        corner-radius 0
    }

    shadow {
        off
    }

    struts {
        left 4
        right 4
    }
}

layer-rule {
    match namespace="^awww-daemon"
    place-within-backdrop true
}

overview {
    workspace-shadow {
        off
    }
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

workspace "ws-1"
workspace "ws-2"
workspace "ws-3"
workspace "ws-4"
workspace "ws-5"
workspace "ws-6"
workspace "ws-7"

gestures {
    dnd-edge-workspace-switch {
        trigger-height 0
    }
    hot-corners {
        off
    }
}

binds {
    Mod+T { spawn "alacritty"; }
    Mod+Q { close-window; }
    Mod+W { spawn "random-wallpaper"; }
    Mod+B { spawn "quickshell" "ipc" "call" "bluetooth" "toggle"; }
    Mod+I { spawn "quickshell" "ipc" "call" "wifi" "toggle"; }

    Mod+O repeat=false { toggle-overview; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }

    Mod+1 { focus-workspace "ws-1"; }
    Mod+2 { focus-workspace "ws-2"; }
    Mod+3 { focus-workspace "ws-3"; }
    Mod+4 { focus-workspace "ws-4"; }
    Mod+5 { focus-workspace "ws-5"; }
    Mod+6 { focus-workspace "ws-6"; }
    Mod+7 { focus-workspace "ws-7"; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+R { switch-focus-between-floating-and-tiling; }

    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+Shift+E { quit; }
    Print { screenshot; }
}

include optional=true "~/.config/niri/colors.kdl"
